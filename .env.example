# =============================================================================
# OpenClaw — environment variables
# =============================================================================
# Local development: copy to .env
# Railway: set these in the service's Variables tab
# =============================================================================

# ── Required ────────────────────────────────────────────────────
# Password protecting the /setup wizard. It is the only thing standing
# between the public internet and first-run configuration.
# On Railway use ${{ secret() }} to generate one.
SETUP_PASSWORD=your-secure-password-here

# State and workspace MUST resolve inside the mounted volume (/data on
# Railway) or configuration, credentials and memory are lost on redeploy.
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace

# ── Recommended ─────────────────────────────────────────────────
# Auth token for the gateway and Control UI. If left blank the wrapper
# generates a new one on every boot, so the UI token changes each deploy.
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ── LLM providers (at least one) ────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── Messaging channels (optional) ───────────────────────────────
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# ── Ports (rarely changed) ──────────────────────────────────────
# Port the wrapper listens on. Railway sets this automatically.
PORT=8080
# Internal gateway port, proxied by the wrapper.
INTERNAL_GATEWAY_PORT=18789
INTERNAL_GATEWAY_HOST=127.0.0.1
